# Copy this file to .env and fill in real values. Never commit .env.
# Password for the PostgreSQL database.
DB_PASSWORD=change-me
# Secret that signs login tokens. 32+ characters. Make one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# Shown to learners on the forgot-password screen, e.g. "Call or WhatsApp +250 78X XXX XXX". Optional.
SUPPORT_CONTACT=
